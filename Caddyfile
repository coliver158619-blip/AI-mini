{
	admin off
	auto_https off
}

:8088 {
	bind 127.0.0.1
	basic_auth {
		{$AI_MINI_USERNAME} {$AI_MINI_PASSWORD_HASH}
	}
	encode zstd gzip
	@static path /assets/*
	header @static >Cache-Control "private, max-age=86400"
	@dynamic not path /assets/*
	header @dynamic >Cache-Control "no-store"
	reverse_proxy 127.0.0.1:5000 {
		header_up -Authorization
	}
}
