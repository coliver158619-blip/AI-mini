# Set these as shell environment variables; this file is documentation, not auto-loaded.
HOST=0.0.0.0
PORT=5000
SEED_DEMO=true
# APP_DATABASE_PATH=C:/absolute/path/companion.sqlite3

# Auto-load the supplied local script; only explicit local selects demo replies.
PET_CHAT_MODE=auto
PET_CHAT_ENV=prod
# PET_CHAT_CONFIG_PATH=C:/absolute/path/test.py
# KUGOU_PET_CHAT_DIR=C:/absolute/path/kugou-pet-chat
# Optional environment overrides. Do not set blank overrides when using a script.
# Legacy pet-chat credentials (v1); the new assistant-v2 script needs no login token.
# PET_CHAT_BASE_URL=
# PET_CHAT_APPKEY=
# PET_CHAT_TOKEN=
# PET_CHAT_USERID=
# PET_CHAT_APPID=1005
# PET_CHAT_CLIENTVER=11111
# PET_CHAT_DFID=
# PET_CHAT_MID=
# PET_CHAT_PET_NAME=乌萨奇
# PET_CHAT_HOST=
# Optional complete KMR endpoint URL for songs with missing metadata.
# PET_CHAT_KMR_URL=
